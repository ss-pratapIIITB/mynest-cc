# Auth for the private /ceo section.
# Generate these with: node scripts/hash-password.mjs "your-new-password"
# Never commit real values — this file only documents the shape.
CEO_USERNAME=
CEO_PASSWORD_HASH=
CEO_SESSION_SECRET=

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX). Not a secret — it's
# public in every page's HTML anyway. Site loads without GA until this is set.
# Vercel Web Analytics needs no env var; just enable it in the dashboard.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Vercel Blob store, used only by /board's "publish a read-only link" button.
# Vercel injects this automatically once a Blob store is linked to the project;
# set it locally only if you want to test publishing. /board works fully
# without it — boards live in the visitor's browser — and the share button is
# simply hidden until it's present.
BLOB_READ_WRITE_TOKEN=
